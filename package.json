{
  "name": "create-ai-native-project",
  "version": "1.2.0",
  "description": "Interactive CLI to scaffold AI-native projects for Claude Code, OpenAI Codex, and OpenCode — instructions, skills, agents, stacks, Docker, and CI",
  "type": "module",
  "bin": {
    "create-ai-native-project": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "agents.md",
    "cli",
    "scaffold",
    "skills",
    "agents"
  ],
  "author": "GeekyAnts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeekyAnts/create-ai-native-project.git"
  },
  "bugs": {
    "url": "https://github.com/GeekyAnts/create-ai-native-project/issues"
  },
  "homepage": "https://github.com/GeekyAnts/create-ai-native-project#readme",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
