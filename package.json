{
  "name": "create-ai-native-project",
  "version": "0.1.0",
  "description": "Interactive CLI to scaffold AI-native projects with CLAUDE.md, skills, and agents",
  "type": "module",
  "bin": {
    "create-ai-native-project": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "scaffold",
    "skills",
    "agents"
  ],
  "author": "GeekyAnts",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
